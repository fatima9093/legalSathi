# Environment Configuration for Legal Sathi Backend
# Copy this file to .env and fill in your actual values

# ============================================================================
# Groq API Configuration (REQUIRED)
# ============================================================================
# Get your API key from: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# ============================================================================
# Supabase Configuration (OPTIONAL - for language preference persistence)
# ============================================================================
# Get your project credentials from: https://app.supabase.com/project/_/settings/api
# This enables the /api/user/{user_id}/language endpoints

# Supabase Project URL
# Example: https://ghwvezmgxpwwfxaeeriy.supabase.co
SUPABASE_URL=your_supabase_project_url

# Supabase Service Role Key (use this for server-side operations)
# ⚠️ KEEP THIS SECRET - Do not commit to version control!
# Found in: Supabase Dashboard → Settings → API → Service role key
SUPABASE_SERVICE_KEY=your_supabase_service_role_key

# ============================================================================
# Optional: OpenAI Agents Configuration
# ============================================================================
# If using the multi-agent pipeline (agent_orchestrator.py)
# This uses Groq via the groq_config.py, so GROQ_API_KEY above is sufficient
# OPENAI_API_KEY=your_openai_api_key_here  # Currently using Groq instead
